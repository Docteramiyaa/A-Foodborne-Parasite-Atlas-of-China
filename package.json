{
  "name": "foodborne-parasite-atlas",
  "private": true,
  "version": "1.0.0",
  "license": "MIT",
  "type": "module",
  "description": "食源虫谱：中国食源性寄生虫图谱与风险查询",
  "scripts": {
    "dev": "concurrently -k -n API,WEB -c cyan,green \"npm:dev:api\" \"npm:dev:web\"",
    "dev:api": "tsx watch server/index.ts",
    "dev:web": "vite",
    "build": "npm run typecheck && vite build",
    "typecheck": "tsc --noEmit -p tsconfig.app.json && tsc --noEmit -p tsconfig.server.json",
    "start": "cross-env NODE_ENV=production tsx server/index.ts",
    "preview": "cross-env NODE_ENV=production PORT=8799 tsx server/index.ts"
  },
  "dependencies": {
    "@fontsource-variable/noto-sans-sc": "^5.2.5",
    "@fontsource-variable/noto-serif-sc": "^5.2.5",
    "clsx": "^2.1.1",
    "compression": "^1.8.0",
    "echarts": "^5.6.0",
    "express": "^4.21.2",
    "lucide-react": "^0.511.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-router-dom": "^6.30.1",
    "zod": "^3.24.2",
    "framer-motion": "^11.18.2"
  },
  "devDependencies": {
    "@types/compression": "^1.7.5",
    "@types/express": "^4.17.21",
    "@types/node": "^22.15.3",
    "@types/react": "^18.3.20",
    "@types/react-dom": "^18.3.6",
    "@vitejs/plugin-react": "^4.5.0",
    "autoprefixer": "^10.4.21",
    "concurrently": "^9.1.2",
    "cross-env": "^7.0.3",
    "postcss": "^8.5.3",
    "tailwindcss": "^3.4.17",
    "tsx": "^4.19.3",
    "typescript": "^5.7.3",
    "vite": "^6.3.5"
  }
}
